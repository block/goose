# Generated by make dev-ui — local goose serve + avocado provider OAuth.
# Sign in: avocado provider (Zitadel PKCE → AVOCADO_PROVISION_URL).
# Model list: fetched at runtime from avcd-llm GET /models/catalog (via goose inventory).
# Do not set GOOSE_EXTERNAL_BACKEND — packaged/dev desktop uses local goose.
GOOSE_SERVER__SECRET_KEY='avcd-agent-local-development-key'
GOOSE_MODE=smart_approve
GOOSE_OAUTH_CALLBACK_PORT=18787
GOOSE_DEFAULT_PROVIDER=avocado
GOOSE_DEFAULT_MODEL=deepseek/deepseek-v4-flash
AVOCADO_HOST=http://127.0.0.1:4000
AVOCADO_PROVISION_URL=http://127.0.0.1:3001/keys/provision
