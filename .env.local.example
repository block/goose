# Local ACP server authentication. Replace before exposing beyond localhost.
GOOSE_SERVER__SECRET_KEY=avcd-agent-local-development-key

# Default provider: avocado (Zitadel PKCE → /llm-api/keys/provision → virtual key).
# Desktop Sign in stores AVOCADO_API_KEY; do not put a Zitadel JWT here.
GOOSE_PROVIDER=avocado
GOOSE_MODEL=deepseek/deepseek-v4-flash
AVOCADO_HOST=https://dev.avocado.tech/llm
# Optional overrides for local/dev against non-default Zitadel / provision:
# AVOCADO_ZITADEL_ISSUER=
# AVOCADO_ZITADEL_CLIENT_ID=
# AVOCADO_ZITADEL_PROJECT_ID=
# AVOCADO_PROVISION_URL=
# Manual override (skips OAuth) for CLI/scripts only:
AVOCADO_API_KEY=

# Optional OpenRouter fallback for legacy Docker CLI experiments.
OPENROUTER_HOST=https://openrouter.ai
OPENROUTER_API_KEY=

# Infisical project UUID. Export this value before pull/upload commands.
INFISICAL_PROJECT_ID=
