# Local ACP server authentication. Replace before exposing beyond localhost.
GOOSE_SERVER__SECRET_KEY=avcd-agent-local-development-key

# AVCD default model provider. The key value is the same credential stored as
# OPENROUTER_KEY in avcd-ai; goose expects the OPENROUTER_API_KEY variable name.
GOOSE_PROVIDER=openrouter
GOOSE_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_HOST=https://openrouter.ai
OPENROUTER_API_KEY=

# Local stack port.
SERVER_PORT=3000

# Infisical project UUID. Export this value before pull/upload commands.
INFISICAL_PROJECT_ID=
