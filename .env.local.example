# Local ACP server authentication. Replace before exposing beyond localhost.
GOOSE_SERVER__SECRET_KEY=avcd-agent-local-development-key

# Optional model provider configuration.
GOOSE_PROVIDER=
GOOSE_MODEL=

# Add only the key required by the selected provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local stack port.
SERVER_PORT=3000
