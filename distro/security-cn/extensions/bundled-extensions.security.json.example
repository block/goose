[
  {
    "id": "aiseesec-mcp",
    "name": "aiseesec-mcp",
    "display_name": "AiseeSec",
    "description": "精选安全能力查询与知识访问（需外部专有 API，当前仍为 disabled stub）",
    "enabled": false,
    "type": "stdio",
