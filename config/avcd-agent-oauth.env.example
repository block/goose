# Copy to config/avcd-agent-oauth.env to enable the desktop login screen.
#
# Generate from the avcd-zitadel repo after the Zitadel terraform apply:
#   cd ../avcd-zitadel && make write-avcd-agent-oauth-env
#   cp ../avcd-zitadel/config/avcd-agent-oauth.env config/avcd-agent-oauth.env
#
# With this file present, `make dev-ui` starts avcd-agent-gateway and boots the
# desktop app behind LoginGuard. Without it, dev-ui refuses to start unless you
# pass DEV_UI_LEGACY=1.

ZITADEL_ISSUER=https://zitadel.avcd.ai
ZITADEL_CLIENT_ID=
ZITADEL_PROJECT_ID=
ZITADEL_ORG_ID=
ZITADEL_GOOGLE_IDP_ID=
AGENT_ACCESS_ROLE_KEY=agent-access
ZITADEL_AUTH_SCOPES=
JWT_REQUIRED=true
