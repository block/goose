# Goose core / goosed first-run defaults.
# Desktop locale and predefined model list must be injected through environment
# variables at package time or local preview startup.
GOOSE_PROVIDER: openai
GOOSE_PROVIDER__TYPE: openai
GOOSE_PROVIDER__HOST: https://tokenhub.tencentmaas.com/plan/v3
GOOSE_PROVIDER__API_KEY: ${TP_ENT_API_KEY}
GOOSE_MODEL: auto
GOOSE_DISABLE_TELEMETRY: 1
